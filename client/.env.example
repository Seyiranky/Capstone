# Local dev without Docker: point axios at the API directly.
VITE_API_URL=http://localhost:4000/api

# Docker Compose sets VITE_API_URL=/api and VITE_PROXY_TARGET=http://server:4000
# in docker-compose.yml so Vite proxies API calls to the server container.

VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com