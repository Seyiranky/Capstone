NODE_ENV=development
PORT=4000
DB_HOST=postgres
DB_PORT=5432
DB_USER=isoko
DB_PASSWORD=isoko
DB_NAME=isoko_talents_dev
DB_NAME_TEST=isoko_talents_test

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Signs skill passports and income statements. Kept separate from JWT_SECRET
# because a passport is a long-lived public credential: leaking one must not
# hand anyone a session token. Falls back to JWT_SECRET if unset.
PASSPORT_SIGNING_SECRET=change-me-too

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
