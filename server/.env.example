# Copy to server/.env and fill in. Every variable here is read by the server;
# the ones marked REQUIRED make it refuse to boot rather than failing later on
# the first request that needs them.

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Development and test read these; production uses DATABASE_URL instead.
DB_HOST=localhost
DB_PORT=5432
DB_USER=isoko
DB_PASSWORD=isoko
DB_NAME=isoko_talents_dev
DB_NAME_TEST=isoko_talents_test
# DATABASE_URL=postgres://user:pass@host:5432/db   # production only, SSL required

# ---- Secrets ----
# REQUIRED. Sessions stop working for everyone if this rotates.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# REQUIRED. Separate from JWT_SECRET because a passport is a long-lived public
# credential, so the two have different lifetimes and blast radii.
PASSPORT_SIGNING_SECRET=change-me-too

# ---- Google sign-in ----
# Optional. Without it the Google button is present but cannot complete.
GOOGLE_CLIENT_ID=

# ---- Payments ----
PAYMENT_PROVIDER=simulated-momo
PAYMENT_WEBHOOK_SECRET=

# ---- SMS ----
# `log` prints instead of sending (no account needed). `pindo` sends for real.
SMS_DRIVER=log
# Pindo dashboard -> profile icon -> Security. Never commit a real one.
PINDO_API_TOKEN=
# PINDO_ENDPOINT=https://api.pindo.io/v1/sms/
# The name texts arrive from. `PindoTest` is Pindo's shared sender and works
# without registration; "Isoko" needs RURA whitelisting plus MTN and Airtel
# registration first. Keep client VITE_SMS_SENDER_NAME in step with it.
SMS_SENDER_ID=PindoTest
# Guards POST /api/webhooks/sms/pindo, Pindo's delivery reports. Sent as an
# X-Webhook-Secret header, or as ?secret=... on the callback URL.
SMS_WEBHOOK_SECRET=
# SMS_TIMEOUT_MS=10000
# Warns in the server log once when the Pindo balance (USD) drops below this.
# SMS_LOW_BALANCE_USD=2

# ---- Email ----
# `log` prints the whole message, including verification links, which is how the
# channel is demonstrated and tested without a mail account. Set `smtp` and the
# four variables below for real mail -- any provider that speaks SMTP will do.
EMAIL_DRIVER=log
EMAIL_FROM=Isoko Talents <notifications@example.com>
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Base URL for links inside emails. Must be the deployed client in production,
# or confirmation links will point at a machine the recipient cannot reach.
APP_URL=http://localhost:5173

# ---- Pilot configuration ----
# Read per request, so these can change without a restart.
RANKED_INVITE_LIMIT=3
EXPLORATION_SLOTS=1
