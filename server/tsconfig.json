{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],

    /* CommonJS throughout. Sequelize's model registry, sequelize-cli's loader
       and the Jest transform all assume CJS, and the five integration tests
       that set process.env after their imports depend on require ordering
       that ESM hoisting would change. */
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* No rootDir/outDir here: this config type-checks src/ and tests/ together
       and never emits, so it must not be constrained to a single root.
       Emit settings live in tsconfig.build.json. */
    "noEmit": true,

    /* Matches client/tsconfig.app.json so both halves of the stack are held
       to one standard. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,

    /* Nothing under src/ or tests/ is JavaScript any more, so plain .js is no
       longer accepted into the program. migrations/ and seeders/ stay
       JavaScript and are excluded below — sequelize-cli loads those itself. */
    "allowJs": false,

    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "migrations", "seeders", "uploads"]
}
