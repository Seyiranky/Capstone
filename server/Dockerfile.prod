# Production image: compiled JavaScript, production dependencies only.
# The development Dockerfile runs TypeScript under tsx with a bind mount;
# this one is what a host runs.

FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig*.json ./
COPY src ./src
RUN npm run build

FROM node:24-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
# sequelize-cli reads these at start to migrate and, on an empty database, seed.
COPY .sequelizerc ./
COPY config ./config
COPY migrations ./migrations
COPY seeders ./seeders
COPY docker-entrypoint.prod.sh ./
# Uploads are written here first; lasting storage is STORAGE_DRIVER (lib/storage).
RUN mkdir -p uploads && chown -R node:node /app
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||4000)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["sh", "docker-entrypoint.prod.sh"]
